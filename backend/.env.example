# Which AI does the photo analysis: "gemini" (free tier, default) or "anthropic"
AI_PROVIDER=gemini

# --- Gemini (free tier, no credit card) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic (paid, higher quality) ---
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

PORT=4000

# --- Auth ---
# Secret used to sign session JWTs (tokens are valid for 1 year, so you sign
# in once per device). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# --- Limits ---
# Max photo-analysis calls per user per day (protects your AI provider bill).
ANALYZE_DAILY_LIMIT=30

# Comma-separated list of origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:5173
